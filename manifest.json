{
  "manifest_version": 3,
  "name": "YouTube Play Fix",
  "version": "1.1.0",
  "description": "Refreshes the page once when a YouTube video starts (fixes playback) and fully blocks YouTube Shorts.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
